# =============================================================================
# Minecraft Server Manager — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# =============================================================================

# --- Dashboard Server ---
# The host the FastAPI dashboard binds to.
# Use 0.0.0.0 to accept connections from your LAN. See README for security notes.
HOST=127.0.0.1
PORT=8000

# --- Security ---
# A strong, random secret used to authenticate every API call and WebSocket.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# KEEP THIS PRIVATE. Anyone with this key can send commands to your Minecraft console.
API_KEY=change_me_to_a_strong_random_secret

# --- Minecraft RAM Allocation ---
# Java heap size for the Minecraft server process (in MB or GB, e.g., 2G, 4G, 1024M).
MC_RAM_MIN=1G
MC_RAM_MAX=4G

# --- Paths ---
# Absolute or relative path to the directory where Minecraft server files are stored.
# server.jar, eula.txt, server.properties, and world/ will live here.
MC_SERVER_DIR=./data/server

# --- Minecraft Version (optional) ---
# Leave blank to always fetch the latest stable PaperMC build.
# Set to a specific version (e.g., 1.21.1) to pin the build.
MC_VERSION=

# --- CORS ---
# Comma-separated list of allowed origins for the REST API.
# Example: http://localhost:8000,http://192.168.1.100:8000
# Use * only in development — NEVER in production/LAN-exposed deployments.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
